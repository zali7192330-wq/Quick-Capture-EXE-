<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickCapture.MainWindow"
        Title="Quick Capture" Width="520" Height="660"
        MinWidth="440" MinHeight="560"
        Background="#1C1C1E" Foreground="#F2F2F2"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="#2C2C30"/>
      <Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="0,16"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="BorderBrush" Value="#3A3A40"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#38383E"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2DD4BF"/>
      <Setter Property="Foreground" Value="#101214"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="0,16"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#5EEAD4"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="36,28,36,20" Spacing="0">
    <TextBlock Text="Quick Capture" FontSize="34" FontWeight="Bold" Margin="0,0,0,10"/>
    <TextBlock Text="Press Ctrl+Shift+Space anytime to capture. Notes save on this PC and to Notion."
               FontSize="15" Foreground="#B9B9C0" TextWrapping="Wrap" Margin="0,0,0,24"/>

    <Button x:Name="NewCaptureButton" Classes="primary" Content="New capture"/>
    <Button x:Name="OpenNotesButton" Classes="nav" Content="Open notes file"/>
    <Button x:Name="OpenNotionButton" Classes="nav" Content="Open Notion database"/>

    <Border Background="#242428" CornerRadius="12" BorderBrush="#3A3A40" BorderThickness="1"
            Padding="18,14" Margin="0,6,0,0">
      <StackPanel Spacing="4">
        <TextBlock Text="Status" FontSize="13" Foreground="#8E8E96"/>
        <TextBlock x:Name="StatusText" Text="Checking Notion…" FontSize="17" FontWeight="SemiBold" Foreground="#2DD4BF"/>
      </StackPanel>
    </Border>

    <StackPanel VerticalAlignment="Bottom" Margin="0,26,0,0">
      <Button x:Name="HideButton" Classes="nav" Content="Hide to tray"/>
      <TextBlock Text="Quit is in the tray icon menu (bottom-right)."
                 FontSize="13" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
